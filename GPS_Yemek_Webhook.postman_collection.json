        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"event\": \"unknown_event\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/api/webhook/orders",
          "host": ["{{base_url}}"],
          "path": ["api", "webhook", "orders"]
        },
        "description": "Tanımsız bir event gönderildiğinde 400 Bad Request döner."
      },
      "response": [
        {
          "name": "Unknown event",
          "status": "Bad Request",
          "code": 400,
          "header": [
            { "key": "Content-Type", "value": "application/json" }
          ],
          "body": "{\n  \"error\": \"Unknown event\"\n}"
        }
      ]
    }
  ]
}
