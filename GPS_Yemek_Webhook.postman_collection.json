              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"event\": \"order_updated\",\n  \"order_code\": \"ORD-12345\",\n  \"status\": \"REJECTED\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/api/webhook/orders",
          "host": ["{{base_url}}"],
          "path": ["api", "webhook", "orders"]
        },
        "description": "Sipariş durumunu REJECT olarak günceller."
      },
      "response": []
    },
    {
      "name": "3. restaurant_status_changed (Durum Değiştir)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{api_token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"event\": \"restaurant_status_changed\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/api/webhook/orders",
          "host": ["{{base_url}}"],
          "path": ["api", "webhook", "orders"]
        },
        "description": "Restoranın current_status'unu toggle eder.\ncurrent_status == 5 ise 0 yapar, 0 ise 5 yapar."
      },
      "response": [
        {
          "name": "Başarılı yanıt",
          "status": "OK",
          "code": 200,
          "header": [
            { "key": "Content-Type", "value": "application/json" }
          ],
          "body": "{\n  \"success\": true,\n  \"restaurant\": {\n    \"id\": 1,\n    \"current_status\": 5\n  }\n}"
        }
      ]
    },
    {
      "name": "4. restaurant_permanently_close (Kalıcı Kapat)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{api_token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"event\": \"restaurant_permanently_close\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/api/webhook/orders",
          "host": ["{{base_url}}"],
          "path": ["api", "webhook", "orders"]
        },
        "description": "Restoranı kalıcı olarak kapatır (permanently_closed = true)."
      },
      "response": [
        {
          "name": "Başarılı yanıt",
          "status": "OK",
          "code": 200,
          "header": [
            { "key": "Content-Type", "value": "application/json" }
          ],
          "body": "{\n  \"success\": true,\n  \"permanently_closed\": true\n}"
        }
      ]
    },
