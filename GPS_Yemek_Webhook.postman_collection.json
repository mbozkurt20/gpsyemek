{
  "info": {
    "name": "GPS Yemek - Webhook API",
    "_postman_id": "gps-yemek-webhook-collection",
    "description": "GPS Yemek webhook endpoint'i için tüm eventleri içeren Postman koleksiyonu.\n\nAuth: Bearer token (restaurant.api_token)\nEndpoint: POST /api/webhook/orders",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://gpsyemek.com",
      "type": "string"
    },
    {
      "key": "api_token",
      "value": "RESTAURANT_API_TOKEN_BURAYA",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. get_orders",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{api_token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"event\": \"get_orders\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/api/webhook/orders",
          "host": ["{{base_url}}"],
          "path": ["api", "webhook", "orders"]
        },
        "description": "Restoranın bugünkü PENDING (bekleyen) siparişlerini döner.\nAyrıca restoranın mevcut durumunu (current_status, permanently_closed, temporary_closed_until) da içerir."
      },
      "response": [
        {
          "name": "Başarılı yanıt",
          "status": "OK",
          "code": 200,
          "header": [
            { "key": "Content-Type", "value": "application/json" }
          ],
          "body": "{\n  \"success\": true,\n  \"orders\": [],\n  \"restaurant_status\": {\n    \"current_status\": 0,\n    \"permanently_closed\": false,\n    \"temporary_closed_until\": null\n  }\n}"
        }
      ]
    },
    {
      "name": "2. order_updated - PREPARED (Hazırlandı)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{api_token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"event\": \"order_updated\",\n  \"order_code\": \"ORD-12345\",\n  \"status\": \"PREPARED\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/api/webhook/orders",
          "host": ["{{base_url}}"],
          "path": ["api", "webhook", "orders"]
        },
        "description": "Sipariş durumunu ACCEPT olarak günceller.\nKullanılabilir status değerleri:\n- PREPARED  → OrderStatus::ACCEPT\n- HANDOVER  → OrderStatus::ON_THE_WAY\n- DELIVERED → OrderStatus::COMPLETED\n- REJECTED  → OrderStatus::REJECT"
      },
      "response": [
        {
          "name": "Başarılı yanıt",
          "status": "OK",
          "code": 200,
          "header": [
            { "key": "Content-Type", "value": "application/json" }
          ],
          "body": "{\n  \"success\": true\n}"
        },
        {
          "name": "Sipariş bulunamadı",
          "status": "Not Found",
          "code": 404,
          "header": [
            { "key": "Content-Type", "value": "application/json" }
          ],
          "body": "{\n  \"success\": false,\n  \"error\": \"Order not found\"\n}"
        }
      ]
    },
    {
      "name": "2. order_updated - HANDOVER (Yola Çıktı)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{api_token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"event\": \"order_updated\",\n  \"order_code\": \"ORD-12345\",\n  \"status\": \"HANDOVER\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/api/webhook/orders",
          "host": ["{{base_url}}"],
          "path": ["api", "webhook", "orders"]
        },
        "description": "Sipariş durumunu ON_THE_WAY olarak günceller."
      },
      "response": []
    },
    {
      "name": "2. order_updated - DELIVERED (Teslim Edildi)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{api_token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"event\": \"order_updated\",\n  \"order_code\": \"ORD-12345\",\n  \"status\": \"DELIVERED\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/api/webhook/orders",
          "host": ["{{base_url}}"],
          "path": ["api", "webhook", "orders"]
        },
        "description": "Sipariş durumunu COMPLETED olarak günceller."
      },
      "response": []
    },
    {
      "name": "2. order_updated - REJECTED (Reddedildi)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
